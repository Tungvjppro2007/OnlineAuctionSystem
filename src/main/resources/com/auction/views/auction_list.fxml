<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" 
            style="-fx-background-color: #f1f5f9;" 
            xmlns="[suspicious link removed]" xmlns:fx="[suspicious link removed]" 
            fx:controller="[đã xoá đường liên kết đáng ngờ].client.controllers.AuctionListController">
   
   <!-- TOP NAVBAR -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20.0" 
            style="-fx-background-color: #0f172a; -fx-padding: 0 25 0 25;">
         <effect>
            <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
               <color>
                  <Color red="0.0" green="0.0" blue="0.0" opacity="0.2" />
               </color>
            </DropShadow>
         </effect>
         <children>
            <!-- Logo & Title -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <ImageView fitHeight="38.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@/com/auction/images/uet_logo.png" />
                     </image>
                     <clip>
                        <Circle centerX="19.0" centerY="19.0" radius="19.0" />
                     </clip>
                  </ImageView>
                  <VBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="UET AUCTION" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label text="Sàn Đấu Giá Trực Tuyến" textFill="#94a3b8">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" prefWidth="320.0" 
                  style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 5 12;">
               <children>
                  <TextField fx:id="searchField" promptText="🔍 Tìm kiếm sản phẩm đấu giá..." 
                             style="-fx-background-color: transparent; -fx-text-inner-color: white; -fx-prompt-text-fill: #64748b; -fx-padding: 4;" 
                             HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- User Info & Logout -->
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <VBox alignment="CENTER_RIGHT">
                     <children>
                        <Label fx:id="welcomeUserLabel" text="Xin chào, Nguyễn Văn A" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Label text="Vai trò: Người đấu giá" textFill="#38bdf8">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Button onAction="#handleLogout" text="Đăng xuất" 
                          style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>

   <!-- LEFT SIDEBAR: BỘ LỌC -->
   <left>
      <VBox prefWidth="240.0" spacing="20.0" 
            style="-fx-background-color: #ffffff; -fx-padding: 25 20 25 20; -fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0;">
         <children>
            <Label text="BỘ LỌC SẢN PHẨM" textFill="#0f172a">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>

            <!-- Danh mục -->
            <VBox spacing="8.0">
               <children>
                  <Label text="Danh mục hàng hóa" textFill="#64748b">
                     <font>
                        <Font name="System Bold" size="11.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="categoryFilterComboBox" maxWidth="1.2E308" promptText="Tất cả danh mục" 
                            style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6;" />
               </children>
            </VBox>

            <!-- Trạng thái phiên -->
            <VBox spacing="8.0">
               <children>
                  <Label text="Trạng thái phiên" textFill="#64748b">
                     <font>
                        <Font name="System Bold" size="11.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="statusFilterComboBox" maxWidth="1.2E308" promptText="Đang diễn ra" 
                            style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6;" />
               </children>
            </VBox>

            <Button maxWidth="1.2E308" onAction="#handleRefresh" text="🔄 Làm mới danh sách" 
                    style="-fx-background-color: #0052cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10; -fx-cursor: hand;" />
         </children>
      </VBox>
   </left>

   <!-- CENTER: BẢNG DANH SÁCH PHIÊN ĐẤU GIÁ -->
   <center>
      <VBox spacing="15.0" style="-fx-padding: 25;">
         <children>
            
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Phiên Đấu Giá Đang Diễn Ra 🔴" textFill="#0f172a">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label text="Chọn sản phẩm để xem chi tiết hoặc tham gia đặt giá thời gian thực" textFill="#64748b">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <!-- TableView danh sách sản phẩm -->
            <TableView fx:id="auctionTable" prefHeight="520.0" VBox.vgrow="ALWAYS" 
                       style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-background-radius: 8; -fx-border-radius: 8;">
               <columns>
                  <TableColumn fx:id="idColumn" prefWidth="70.0" text="Mã ID" />
                  <TableColumn fx:id="nameColumn" prefWidth="230.0" text="Tên sản phẩm" />
                  <TableColumn fx:id="categoryColumn" prefWidth="130.0" text="Danh mục" />
                  <TableColumn fx:id="priceColumn" prefWidth="140.0" text="Giá hiện tại (VNĐ)" />
                  <TableColumn fx:id="highestBidderColumn" prefWidth="150.0" text="Người giữ giá" />
                  <TableColumn fx:id="timeLeftColumn" prefWidth="120.0" text="Thời gian còn lại" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

         </children>
      </VBox>
   </center>

</BorderPane>