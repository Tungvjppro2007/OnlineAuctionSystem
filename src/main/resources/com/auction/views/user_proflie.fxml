<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1120.0" 
            style="-fx-background-color: #f8fafc;" 
            xmlns="[suspicious link removed]" xmlns:fx="[suspicious link removed]" 
            fx:controller="[đã xoá đường liên kết đáng ngờ].client.controllers.UserProfileController">
   
   <!-- TOP NAVBAR -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20.0" 
            style="-fx-background-color: #0f172a; -fx-padding: 0 25 0 25;">
         <effect>
            <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
               <color>
                  <Color red="0.0" green="0.0" blue="0.0" opacity="0.2" />
               </color>
            </DropShadow>
         </effect>
         <children>
            <Button onAction="#handleBackToList" text="← Quay lại danh sách" 
                    style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" />
            
            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@/com/auction/images/uet_logo.png" />
                     </image>
                     <clip>
                        <Circle centerX="16.0" centerY="16.0" radius="16.0" />
                     </clip>
                  </ImageView>
                  <Label text="HỒ SƠ CÁ NHÂN &amp; VÍ ĐẤU GIÁ" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#handleLogout" text="Đăng xuất" 
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" />
         </children>
      </HBox>
   </top>

   <!-- CENTER CONTENT -->
   <center>
      <HBox spacing="25.0" style="-fx-padding: 25;">
         <children>
            
            <!-- CỘT TRÁI: THÔNG TIN TÀI KHOẢN & VÍ TIỀN -->
            <VBox prefWidth="380.0" spacing="20.0">
               <children>
                  
                  <!-- CARD USER PROFILE -->
                  <VBox alignment="CENTER" spacing="14.0" 
                        style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                     <effect>
                        <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
                           <color>
                              <Color red="0.0" green="0.0" blue="0.0" opacity="0.05" />
                           </color>
                        </DropShadow>
                     </effect>
                     <children>
                        <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@/com/auction/images/uet_logo.png" />
                           </image>
                           <clip>
                              <Circle centerX="45.0" centerY="45.0" radius="45.0" />
                           </clip>
                        </ImageView>

                        <VBox alignment="CENTER" spacing="4.0">
                           <children>
                              <Label fx:id="fullNameLabel" text="Nguyễn Văn A" textFill="#0f172a">
                                 <font>
                                    <Font name="System Bold" size="18.0" />
                                 </font>
                              </Label>
                              <Label fx:id="usernameLabel" text="@user_nam99" textFill="#64748b">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>

                        <HBox alignment="CENTER" spacing="8.0" 
                              style="-fx-background-color: #e0e7ff; -fx-background-radius: 20; -fx-padding: 4 14;">
                           <children>
                              <Label fx:id="roleLabel" text="MEMBER • BIDDER" textFill="#4338ca">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- CARD VÍ TIỀN & NẠP TIỀN -->
                  <VBox spacing="14.0" 
                        style="-fx-background-color: linear-gradient(to bottom right, #0052cc, #1e40af); -fx-background-radius: 12; -fx-padding: 22;">
                     <effect>
                        <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
                           <color>
                              <Color red="0.0" green="0.2" blue="0.6" opacity="0.3" />
                           </color>
                        </DropShadow>
                     </effect>
                     <children>
                        <Label text="SỐ DƯ VÍ ĐẤU GIÁ 💳" textFill="#93c5fd">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>

                        <Label fx:id="balanceLabel" text="100,000,000 VNĐ" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>

                        <VBox spacing="8.0">
                           <children>
                              <HBox spacing="8.0">
                                 <children>
                                    <TextField fx:id="depositAmountField" promptText="Nhập số tiền nạp..." 
                                               style="-fx-background-color: #ffffff; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 10; -fx-font-size: 12px;" 
                                               HBox.hgrow="ALWAYS" />
                                    <Button onAction="#handleDeposit" text="Nạp tiền" 
                                            style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 14; -fx-cursor: hand;" />
                                 </children>
                              </HBox>
                              <Label fx:id="depositStatusLabel" wrapText="true">
                                 <font>
                                    <Font size="11.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </VBox>

               </children>
            </VBox>

            <!-- CỘT PHẢI: QUẢN LÝ LỊCH SỬ THẮNG THẦU & ĐẶT GIÁ -->
            <VBox spacing="16.0" HBox.hgrow="ALWAYS">
               <children>
                  
                  <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" 
                           style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-padding: 10;">
                     <tabs>
                        
                        <!-- TAB 1: SẢN PHẨM ĐÃ THẮNG THẦU -->
                        <Tab text="🏆 Sản Phẩm Đã Thắng Thầu">
                           <content>
                              <VBox spacing="12.0" style="-fx-padding: 15 5 5 5;">
                                 <children>
                                    <TableView fx:id="wonAuctionTable" prefHeight="450.0" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="wonIdCol" prefWidth="80.0" text="Mã SP" />
                                          <TableColumn fx:id="wonNameCol" prefWidth="220.0" text="Tên sản phẩm" />
                                          <TableColumn fx:id="wonPriceCol" prefWidth="150.0" text="Giá thắng (VNĐ)" />
                                          <TableColumn fx:id="wonDateCol" prefWidth="140.0" text="Ngày thắng" />
                                          <TableColumn fx:id="wonStatusCol" prefWidth="120.0" text="Trạng thái" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                           </content>
                        </Tab>

                        <!-- TAB 2: LỊCH SỬ TẤT CẢ CÁC LẦN RA GIÁ -->
                        <Tab text="📜 Lịch Sử Ra Giá">
                           <content>
                              <VBox spacing="12.0" style="-fx-padding: 15 5 5 5;">
                                 <children>
                                    <TableView fx:id="biddingHistoryTable" prefHeight="450.0" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="bidItemNameCol" prefWidth="220.0" text="Sản phẩm" />
                                          <TableColumn fx:id="bidAmountCol" prefWidth="160.0" text="Mức giá đặt (VNĐ)" />
                                          <TableColumn fx:id="bidTimeCol" prefWidth="160.0" text="Thời gian đặt" />
                                          <TableColumn fx:id="bidResultCol" prefWidth="140.0" text="Kết quả" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                           </content>
                        </Tab>

                     </tabs>
                  </TabPane>

               </children>
            </VBox>

         </children>
      </HBox>
   </center>

</BorderPane>