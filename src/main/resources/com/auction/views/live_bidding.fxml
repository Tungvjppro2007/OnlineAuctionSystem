<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1120.0" 
            style="-fx-background-color: #f8fafc;" 
            xmlns="[suspicious link removed]" xmlns:fx="[suspicious link removed]" 
            fx:controller="[đã xoá đường liên kết đáng ngờ].client.controllers.LiveBiddingController">
   
   <!-- TOP NAVBAR -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20.0" 
            style="-fx-background-color: #0f172a; -fx-padding: 0 25 0 25;">
         <effect>
            <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
               <color>
                  <Color red="0.0" green="0.0" blue="0.0" opacity="0.2" />
               </color>
            </DropShadow>
         </effect>
         <children>
            <Button onAction="#handleBackToList" text="← Quay lại danh sách" 
                    style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" />
            
            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@/com/auction/images/uet_logo.png" />
                     </image>
                     <clip>
                        <Circle centerX="16.0" centerY="16.0" radius="16.0" />
                     </clip>
                  </ImageView>
                  <Label text="PHIÊN ĐẤU GIÁ LIVE" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="currentUserLabel" text="Người dùng: user_nam99" textFill="#cbd5e1">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>

   <!-- CENTER CONTENT -->
   <center>
      <HBox spacing="25.0" style="-fx-padding: 25;">
         <children>
            
            <!-- CỘT TRÁI: THÔNG TIN SẢN PHẨM -->
            <VBox prefWidth="480.0" spacing="20.0" HBox.hgrow="ALWAYS">
               <children>
                  <VBox spacing="15.0" 
                        style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                     <effect>
                        <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
                           <color>
                              <Color red="0.0" green="0.0" blue="0.0" opacity="0.05" />
                           </color>
                        </DropShadow>
                     </effect>
                     <children>
                        <!-- Ảnh sản phẩm -->
                        <HBox alignment="CENTER" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 15;">
                           <children>
                              <ImageView fx:id="itemImageView" fitHeight="220.0" fitWidth="320.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@/com/auction/images/uet_logo.png" />
                                 </image>
                              </ImageView>
                           </children>
                        </HBox>

                        <VBox spacing="6.0">
                           <children>
                              <Label fx:id="categoryLabel" text="DANH MỤC: THIẾT BỊ ĐIỆN TỬ" textFill="#0052cc">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <Label fx:id="itemNameLabel" text="Laptop MacBook Pro M3 Max 16-inch 64GB" textFill="#0f172a" wrapText="true">
                                 <font>
                                    <Font name="System Bold" size="18.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>

                        <!-- Chi tiết thông số -->
                        <VBox spacing="8.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 12;">
                           <children>
                              <HBox>
                                 <children>
                                    <Label text="Mã sản phẩm:" textFill="#64748b" prefWidth="130.0" />
                                    <Label fx:id="itemIdLabel" text="AUC001" textFill="#0f172a" style="-fx-font-weight: bold;" />
                                 </children>
                              </HBox>
                              <HBox>
                                 <children>
                                    <Label text="Giá khởi điểm:" textFill="#64748b" prefWidth="130.0" />
                                    <Label fx:id="startingPriceLabel" text="30,000,000 VNĐ" textFill="#0f172a" style="-fx-font-weight: bold;" />
                                 </children>
                              </HBox>
                              <HBox>
                                 <children>
                                    <Label text="Bước giá tối thiểu:" textFill="#64748b" prefWidth="130.0" />
                                    <Label fx:id="stepPriceLabel" text="500,000 VNĐ" textFill="#0f172a" style="-fx-font-weight: bold;" />
                                 </children>
                              </HBox>
                              <HBox>
                                 <children>
                                    <Label text="Người bán:" textFill="#64748b" prefWidth="130.0" />
                                    <Label fx:id="sellerNameLabel" text="Cửa Hàng Công Nghệ UET" textFill="#0052cc" style="-fx-font-weight: bold;" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- Mô tả sản phẩm -->
                        <VBox spacing="4.0">
                           <children>
                              <Label text="Mô tả sản phẩm" textFill="#334155">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <Label fx:id="descriptionLabel" text="Máy mới 99% nguyên hộp đầy đủ phụ kiện. Bảo hành chính hãng 12 tháng. Cấu hình M3 Max 16 CPU - 40 GPU siêu mạnh mẽ." textFill="#64748b" wrapText="true">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- CỘT PHẢI: KHU VỰC ĐẤU GIÁ LIVE -->
            <VBox prefWidth="540.0" spacing="20.0" HBox.hgrow="ALWAYS">
               <children>
                  
                  <!-- CARD GIÁ HIỆN TẠI & ĐẾM NGƯỢC -->
                  <VBox spacing="16.0" 
                        style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                     <effect>
                        <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
                           <color>
                              <Color red="0.0" green="0.0" blue="0.0" opacity="0.05" />
                           </color>
                        </DropShadow>
                     </effect>
                     <children>
                        <HBox alignment="CENTER" spacing="20.0">
                           <children>
                              <!-- Khung giá cao nhất -->
                              <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" spacing="4.0" 
                                    style="-fx-background-color: #f0fdf4; -fx-border-color: #bbf7d0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16;">
                                 <children>
                                    <Label text="GIÁ CAO NHẤT HIỆN TẠI 🟢" textFill="#166534">
                                       <font>
                                          <Font name="System Bold" size="11.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="currentPriceLabel" text="45,000,000 VNĐ" textFill="#15803d">
                                       <font>
                                          <Font name="System Bold" size="22.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="highestBidderLabel" text="Người giữ giá: user_nam99" textFill="#166534">
                                       <font>
                                          <Font size="11.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>

                              <!-- Đồng hồ đếm ngược -->
                              <VBox alignment="CENTER" prefWidth="180.0" spacing="4.0" 
                                    style="-fx-background-color: #fef2f2; -fx-border-color: #fecaca; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16;">
                                 <children>
                                    <Label text="THỜI GIAN CÒN LẠI ⏳" textFill="#991b1b">
                                       <font>
                                          <Font name="System Bold" size="11.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="timerLabel" text="04:32" textFill="#dc2626">
                                       <font>
                                          <Font name="System Bold" size="24.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- FORM NHẬP BƯỚC GIÁ -->
                        <VBox spacing="10.0">
                           <children>
                              <Label text="Nhập số tiền muốn đặt giá (VNĐ):" textFill="#334155">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              
                              <HBox spacing="10.0">
                                 <children>
                                    <TextField fx:id="bidAmountField" promptText="Mức giá tối thiểu: 45,500,000" 
                                               style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 14px; -fx-font-weight: bold;" 
                                               HBox.hgrow="ALWAYS" />
                                    <Button fx:id="placeBidButton" onAction="#handlePlaceBid" text="🔥 ĐẶT GIÁ NGAY" 
                                            style="-fx-background-color: linear-gradient(to right, #16a34a, #15803d); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;">
                                       <effect>
                                          <DropShadow blurType="GAUSSIAN" height="10.0" radius="4.5" width="10.0">
                                             <color>
                                                <Color red="0.0" green="0.6" blue="0.2" opacity="0.3" />
                                             </color>
                                          </DropShadow>
                                       </effect>
                                    </Button>
                                 </children>
                              </HBox>

                              <!-- Các nút tăng giá nhanh -->
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label text="Cộng nhanh:" textFill="#64748b">
                                       <font>
                                          <Font size="11.0" />
                                       </font>
                                    </Label>
                                    <Button onAction="#handleQuickAdd500k" text="+500.000" style="-fx-background-color: #e2e8f0; -fx-background-radius: 6; -fx-cursor: hand;" />
                                    <Button onAction="#handleQuickAdd1M" text="+1.000.000" style="-fx-background-color: #e2e8f0; -fx-background-radius: 6; -fx-cursor: hand;" />
                                    <Button onAction="#handleQuickAdd2M" text="+2.000.000" style="-fx-background-color: #e2e8f0; -fx-background-radius: 6; -fx-cursor: hand;" />
                                 </children>
                              </HBox>

                              <Label fx:id="statusLabel" alignment="CENTER" maxWidth="1.2E308" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- BẢNG LỊCH SỬ ĐẶT GIÁ LIVE -->
                  <VBox spacing="10.0" VBox.vgrow="ALWAYS" 
                        style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                     <children>
                        <Label text="LỊCH SỬ RA GIÁ REAL-TIME 📊" textFill="#0f172a">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>

                        <TableView fx:id="bidHistoryTable" prefHeight="220.0" VBox.vgrow="ALWAYS" 
                                   style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-background-radius: 6; -fx-border-radius: 6;">
                           <columns>
                              <TableColumn fx:id="timeCol" prefWidth="110.0" text="Thời gian" />
                              <TableColumn fx:id="bidderCol" prefWidth="160.0" text="Người đặt giá" />
                              <TableColumn fx:id="amountCol" prefWidth="180.0" text="Mức giá đặt (VNĐ)" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>

               </children>
            </VBox>

         </children>
      </HBox>
   </center>

</BorderPane>